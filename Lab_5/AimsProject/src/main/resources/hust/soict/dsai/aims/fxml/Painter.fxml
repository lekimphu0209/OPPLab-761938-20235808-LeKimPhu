<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hust.soict.dsai.aims.controller.PainterController">
   <left>
      <VBox spacing="20.0" alignment="CENTER" prefWidth="100.0">
         <children>
            <Label text="Tools" style="-fx-font-weight: bold;"/>
            <RadioButton fx:id="penRadio" text="Pen" selected="true">
               <toggleGroup>
                  <ToggleGroup fx:id="toolGroup"/>
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="eraserRadio" text="Eraser">
               <toggleGroup>
                  <ToggleGroup fx:id="toolGroup"/>
               </toggleGroup>
            </RadioButton>
            <Separator/>
            <Button fx:id="clearButton" mnemonicParsing="false" text="Clear" onAction="#clearCanvas"/>
         </children>
         <padding>
            <Insets top="20.0" bottom="20.0" left="10.0" right="10.0"/>
         </padding>
      </VBox>
   </left>
   
   <center>
      <Pane fx:id="canvasPane" prefHeight="600.0" prefWidth="800.0" 
            style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 1px;"
            onMousePressed="#handleMousePressed"/>
   </center>
</BorderPane>
