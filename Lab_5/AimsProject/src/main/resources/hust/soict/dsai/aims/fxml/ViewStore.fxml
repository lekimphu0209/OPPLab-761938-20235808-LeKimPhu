<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="hust.soict.dsai.aims.controller.ViewStoreController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="800.0" spacing="20.0">
         <children>
            <Label text="AIMS" style="-fx-font-size: 24.0; -fx-font-weight: bold; -fx-text-fill: #2E86AB;">
               <HBox.margin>
                  <Insets left="20.0"/>
               </HBox.margin>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="viewCartButton" mnemonicParsing="false" text="View Cart" onAction="#viewCart">
               <HBox.margin>
                  <Insets right="20.0"/>
               </HBox.margin>
            </Button>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
         </padding>
      </HBox>
      
      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
         <content>
            <GridPane fx:id="mediaGridPane" hgap="20.0" vgap="20.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
               </padding>
            </GridPane>
         </content>
      </ScrollPane>
   </children>
</VBox>
