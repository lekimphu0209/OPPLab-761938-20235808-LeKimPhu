<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="150.0" prefWidth="200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="hust.soict.dsai.aims.controller.MediaItemController">
   <children>
      <VBox layoutX="10.0" layoutY="10.0" prefHeight="130.0" prefWidth="180.0" spacing="10.0">
         <children>
            <Label fx:id="titleLabel" text="Title" style="-fx-font-weight: bold; -fx-font-size: 14.0;" wrapText="true"/>
            <Label fx:id="costLabel" text="Cost" style="-fx-text-fill: #A23B72; -fx-font-size: 16.0;"/>
            <HBox spacing="10.0" alignment="CENTER">
               <children>
                  <Button fx:id="addToCartButton" mnemonicParsing="false" text="Add to Cart" onAction="#addToCart"/>
                  <Button fx:id="playButton" mnemonicParsing="false" text="Play" onAction="#play" visible="false"/>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
         </padding>
      </VBox>
   </children>
   <style>
      -fx-border-color: #E0E0E0;
      -fx-border-radius: 5.0;
      -fx-background-color: #FFFFFF;
      -fx-background-radius: 5.0;
   </style>
</AnchorPane>
