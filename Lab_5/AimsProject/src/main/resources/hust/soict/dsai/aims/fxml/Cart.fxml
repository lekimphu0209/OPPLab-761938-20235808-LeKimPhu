<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hust.soict.dsai.aims.controller.CartController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="800.0" spacing="20.0">
         <children>
            <Label text="AIMS" style="-fx-font-size: 24.0; -fx-font-weight: bold; -fx-text-fill: #2E86AB;">
               <HBox.margin>
                  <Insets left="20.0"/>
               </HBox.margin>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="viewStoreButton" mnemonicParsing="false" text="View Store" onAction="#viewStore">
               <HBox.margin>
                  <Insets right="20.0"/>
               </HBox.margin>
            </Button>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
         </padding>
      </HBox>
   </top>
   
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <children>
                  <Label text="Filter:"/>
                  <TextField fx:id="filterTextField" prefWidth="200.0" promptText="Enter ID or Title"/>
                  <RadioButton fx:id="filterByIdRadio" text="Filter by ID"/>
                  <RadioButton fx:id="filterByTitleRadio" text="Filter by Title"/>
               </children>
               <padding>
                  <Insets left="20.0" right="20.0" top="10.0"/>
               </padding>
            </HBox>
            
            <TableView fx:id="cartTableView" prefHeight="400.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="idColumn" prefWidth="100.0" text="ID"/>
                <TableColumn fx:id="titleColumn" prefWidth="300.0" text="Title"/>
                <TableColumn fx:id="categoryColumn" prefWidth="200.0" text="Category"/>
                <TableColumn fx:id="costColumn" prefWidth="100.0" text="Cost"/>
              </columns>
               <VBox.margin>
                  <Insets left="20.0" right="20.0"/>
               </VBox.margin>
            </TableView>
            
            <HBox spacing="20.0" alignment="CENTER">
               <children>
                  <Button fx:id="playButton" mnemonicParsing="false" text="Play" onAction="#playMedia" disable="true"/>
                  <Button fx:id="removeButton" mnemonicParsing="false" text="Remove" onAction="#removeMedia" disable="true"/>
               </children>
               <padding>
                  <Insets left="20.0" right="20.0" bottom="10.0"/>
               </padding>
            </HBox>
         </children>
      </VBox>
   </center>
   
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="20.0" prefHeight="60.0">
         <children>
            <Label fx:id="totalCostLabel" text="Total Cost: $0.00" style="-fx-font-size: 18.0; -fx-font-weight: bold;"/>
            <Button fx:id="placeOrderButton" mnemonicParsing="false" text="Place Order" onAction="#placeOrder"/>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="10.0"/>
         </padding>
      </HBox>
   </bottom>
</BorderPane>
